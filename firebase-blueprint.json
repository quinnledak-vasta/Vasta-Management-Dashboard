{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A management task assigned to a trainer",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedTo": { "type": "string" },
        "assignedToName": { "type": "string" },
        "assignedToIds": { "type": "array" },
        "assignedToNames": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "isRecurring": { "type": "boolean" },
        "recurrenceInterval": { "type": "string", "enum": ["daily", "weekly", "monthly", "none"] },
        "notes": { "type": "array" },
        "questions": { "type": "array" }
      },
      "required": ["title", "assignedTo", "status", "priority", "dueDate"]
    },
    "User": {
      "title": "User",
      "description": "A system user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "trainer", "owner"] },
        "location": { "type": "string", "enum": ["Dorset Street", "Shelburne Road", "West Palm Beach"] },
        "photoURL": { "type": "string" },
        "certifications": { "type": "array" },
        "checkIns": { "type": "array" },
        "birthday": { "type": "string" },
        "workAnniversary": { "type": "string" },
        "apparel": { "type": "array" },
        "checkInAlertsSent": { "type": "array" },
        "annualReviews": { "type": "array" },
        "annualReviewAlertsSent": { "type": "array" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Invite": {
      "title": "Invite",
      "description": "An invitation to join the team",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "trainer", "owner"] },
        "location": { "type": "string", "enum": ["Dorset Street", "Shelburne Road", "West Palm Beach"] },
        "invitedBy": { "type": "string" },
        "invitedByName": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "accepted", "expired"] }
      },
      "required": ["email", "role", "location", "status"]
    },
    "VacationRequest": {
      "title": "Vacation Request",
      "description": "A vacation or time-off request for a team member",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "type": { "type": "string", "enum": ["vacation", "sick", "personal", "other"] },
        "hours": { "type": "number", "description": "Number of hours affected" }
      },
      "required": ["userId", "startDate", "endDate", "status", "type"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "An item in the physical inventory (equipment, retail, or staff)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["equipment", "retail-equipment", "retail-food-drink", "retail-apparel", "staff-apparel"] },
        "location": { "type": "string", "enum": ["Dorset Street", "Shelburne Road", "West Palm Beach"] },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "productLink": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "location", "quantity", "updatedAt"]
    },
    "InventoryReport": {
      "title": "Inventory Report",
      "description": "A snapshot report of inventory levels at a specific location",
      "type": "object",
      "properties": {
        "location": { "type": "string", "enum": ["Dorset Street", "Shelburne Road", "West Palm Beach"] },
        "reportedBy": { "type": "string" },
        "reportedByName": { "type": "string" },
        "reportedAt": { "type": "string", "format": "date-time" },
        "items": { "type": "array" },
        "notes": { "type": "string" }
      },
      "required": ["location", "reportedBy", "reportedAt", "items"]
    },
    "Mail": {
      "title": "Mail",
      "description": "Trigger Email extension collection",
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "message": {
          "type": "object",
          "properties": {
            "subject": { "type": "string" },
            "text": { "type": "string" },
            "html": { "type": "string" }
          }
        }
      },
      "required": ["to", "message"]
    },
    "Resource": {
      "title": "Resource",
      "description": "A frequently used document or link",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "url", "createdAt", "createdBy"]
    },
    "Course": {
      "title": "Course",
      "description": "An onboarding training course",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "createdAt", "createdBy"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "A chapter grouping multiple lessons in a course",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "title", "order", "createdAt"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "An individual instruction or checklist module",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "chapterId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "videoUrl": { "type": "string" },
        "textBody": { "type": "string" },
        "duration": { "type": "number" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "chapterId", "title", "order", "createdAt"]
    },
    "UserLessonProgress": {
      "title": "UserLessonProgress",
      "description": "Onboarding progress tracking for lessons",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "lessonId": { "type": "string" },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "lessonId", "completed"]
    },
    "StaffEvent": {
      "title": "StaffEvent",
      "description": "An event on the team staff calendar",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["outing", "meeting", "party", "other"] },
        "location": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" }
      },
      "required": ["title", "date", "type", "createdAt", "createdBy", "createdByName"]
    },
    "LessonFile": {
      "title": "LessonFile",
      "description": "Shared file attachment/document/video for onboarding course content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "size": { "type": "number" },
        "totalChunks": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "uploadedBy": { "type": "string" }
      },
      "required": ["id", "fileName", "totalChunks"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Global tasks collection"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/invites/{email}": {
      "schema": "Invite",
      "description": "Active invitations"
    },
    "/vacations/{vacationId}": {
      "schema": "VacationRequest",
      "description": "Vacation and time-off requests"
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Physical inventory items"
    },
    "/inventoryReports/{reportId}": {
      "schema": "InventoryReport",
      "description": "Inventory count reports"
    },
    "/mail/{mailId}": {
      "schema": "Mail",
      "description": "Email trigger requests"
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Frequently used links and documents"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Onboarding courses"
    },
    "/chapters/{chapterId}": {
      "schema": "Chapter",
      "description": "Course chapters"
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Syllabus lessons"
    },
    "/course_progress/{progressId}": {
      "schema": "UserLessonProgress",
      "description": "User course progress"
    },
    "/staff_events/{eventId}": {
      "schema": "StaffEvent",
      "description": "Staff social and operations events calendar"
    },
    "/lesson_files/{fileId}": {
      "schema": "LessonFile",
      "description": "Shared course files and documents"
    }
  }
}
