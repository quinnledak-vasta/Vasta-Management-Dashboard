{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A management task assigned to a trainer",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedTo": { "type": "string" },
        "assignedToName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "isRecurring": { "type": "boolean" },
        "recurrenceInterval": { "type": "string", "enum": ["daily", "weekly", "monthly", "none"] },
        "notes": { "type": "array" },
        "questions": { "type": "array" }
      },
      "required": ["title", "assignedTo", "status", "priority", "dueDate"]
    },
    "User": {
      "title": "User",
      "description": "A system user",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "trainer"] }
      }
    },
    "StaffMember": {
      "title": "Staff Member",
      "description": "A managed staff member without app access",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string", "enum": ["Dorset Street", "Shelburne Road", "West Palm Beach"] },
        "department": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["name", "location", "status"]
    },
    "VacationRequest": {
      "title": "Vacation Request",
      "description": "A vacation or time-off request for a staff member",
      "type": "object",
      "properties": {
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "type": { "type": "string", "enum": ["vacation", "sick", "personal", "other"] },
        "hours": { "type": "number", "description": "Number of hours affected" }
      },
      "required": ["staffId", "startDate", "endDate", "status", "type"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Global tasks collection"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/staff/{staffId}": {
      "schema": "StaffMember",
      "description": "Managed staff members"
    },
    "/vacations/{vacationId}": {
      "schema": "VacationRequest",
      "description": "Vacation and time-off requests"
    }
  }
}
