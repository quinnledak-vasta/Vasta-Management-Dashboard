{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A management task assigned to a trainer",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedTo": { "type": "string" },
        "assignedToName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "isRecurring": { "type": "boolean" },
        "recurrenceInterval": { "type": "string", "enum": ["daily", "weekly", "monthly", "none"] },
        "notes": { "type": "array" },
        "questions": { "type": "array" }
      },
      "required": ["title", "assignedTo", "status", "priority", "dueDate"]
    },
    "User": {
      "title": "User",
      "description": "A system user",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "trainer"] }
      }
    },
    "StaffMember": {
      "title": "Staff Member",
      "description": "A managed staff member without app access",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string", "enum": ["Dorset Street", "Shelburne Road", "West Palm Beach"] },
        "department": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["name", "location", "status"]
    },
    "VacationRequest": {
      "title": "Vacation Request",
      "description": "A vacation or time-off request for a staff member",
      "type": "object",
      "properties": {
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "type": { "type": "string", "enum": ["vacation", "sick", "personal", "other"] },
        "hours": { "type": "number", "description": "Number of hours affected" }
      },
      "required": ["staffId", "startDate", "endDate", "status", "type"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "An item in the physical inventory (equipment, retail, or staff)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["equipment", "retail-equipment", "retail-food-drink", "retail-apparel", "staff-apparel"] },
        "location": { "type": "string", "enum": ["Dorset Street", "Shelburne Road", "West Palm Beach"] },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "productLink": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "location", "quantity", "updatedAt"]
    },
    "InventoryReport": {
      "title": "Inventory Report",
      "description": "A snapshot report of inventory levels at a specific location",
      "type": "object",
      "properties": {
        "location": { "type": "string", "enum": ["Dorset Street", "Shelburne Road", "West Palm Beach"] },
        "reportedBy": { "type": "string" },
        "reportedByName": { "type": "string" },
        "reportedAt": { "type": "string", "format": "date-time" },
        "items": { "type": "array" },
        "notes": { "type": "string" }
      },
      "required": ["location", "reportedBy", "reportedAt", "items"]
    },
    "Mail": {
      "title": "Mail",
      "description": "Trigger Email extension collection",
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "message": {
          "type": "object",
          "properties": {
            "subject": { "type": "string" },
            "text": { "type": "string" },
            "html": { "type": "string" }
          }
        }
      },
      "required": ["to", "message"]
    },
    "Resource": {
      "title": "Resource",
      "description": "A frequently used document or link",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "url", "createdAt", "createdBy"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Global tasks collection"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/staff/{staffId}": {
      "schema": "StaffMember",
      "description": "Managed staff members"
    },
    "/vacations/{vacationId}": {
      "schema": "VacationRequest",
      "description": "Vacation and time-off requests"
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Physical inventory items"
    },
    "/inventoryReports/{reportId}": {
      "schema": "InventoryReport",
      "description": "Inventory count reports"
    },
    "/mail/{mailId}": {
      "schema": "Mail",
      "description": "Email trigger requests"
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Frequently used links and documents"
    }
  }
}
