# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SENDGRID_API_KEY: Required for direct SendGrid email delivery.
# Configured via Settings > Secrets panel.
SENDGRID_API_KEY="SG.my_sendgrid_api_key"

# SENDGRID_FROM_EMAIL: Default verified sender in SendGrid (e.g. quinnledak@vastasports.com or noreply@vastasports.com)
SENDGRID_FROM_EMAIL="quinnledak@vastasports.com"
