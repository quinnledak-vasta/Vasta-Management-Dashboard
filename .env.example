# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SENDGRID_API_KEY: Required for direct SendGrid email delivery.
# Paste the key directly WITHOUT quotation marks (e.g. SG.xxxx...)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# SENDGRID_FROM_EMAIL: Default verified sender in SendGrid (e.g. quinnledak@vastasports.com or noreply@vastasports.com)
SENDGRID_FROM_EMAIL="quinnledak@vastasports.com"

# GOOGLE WORKSPACE / GMAIL SMTP (Alternative to SendGrid for direct backend email)
# GMAIL_APP_PASSWORD: 16-character Google App Password from myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
# SMTP_USER: Google Workspace email address (default: quinnledak@vastasports.com)
SMTP_USER=quinnledak@vastasports.com
