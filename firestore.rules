rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: tasks
    // Fields: title, description, assignedTo (array), dueDate, priority, status, createdAt, createdBy, notes (array), questions (array)
    //
    // Collection: invites
    // Fields: email, role, invitedBy, invitedByName, sentAt, status
    //
    // Collection: alerts
    // Fields: recipientEmail, subject, body, sentAt, status
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "quinnledak@vastasports.com" || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isInvited() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()));
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             (data.assignedTo is string || data.assignedTo is list) &&
             data.priority in ['low', 'medium', 'high'] &&
             data.status in ['pending', 'in-progress', 'completed'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (isInvited() || isAdmin());
      allow create: if isAdmin() && isValidTask(request.resource.data);
      allow update: if isAuthenticated() && (isInvited() || isAdmin()) && isValidTask(request.resource.data);
      allow delete: if isAdmin();
    }

    match /invites/{email} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
