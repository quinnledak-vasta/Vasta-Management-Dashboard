rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailAdmin() {
      return isAuthenticated() && request.auth.token.email == 'quinnledak@vastasports.com';
    }

    function isRoleAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isRoleTrainer() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer';
    }

    function isAdmin() {
      return isEmailAdmin() || isRoleAdmin();
    }

    function isStaff() {
      return isAdmin() || isRoleTrainer();
    }

    // ===============================================================
    // Validation Functions
    // ===============================================================
    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.description is string &&
             data.assignedTo is string && 
             data.assignedToName is string &&
             data.status in ['pending', 'in-progress', 'completed'] &&
             data.priority in ['low', 'medium', 'high'] &&
             data.dueDate is string &&
             data.createdAt is string &&
             data.createdBy is string &&
             data.isRecurring is bool &&
             data.recurrenceInterval in ['daily', 'weekly', 'monthly', 'none'];
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string &&
             data.role in ['admin', 'trainer'];
    }

    function isValidInvite(data) {
      return data.email is string &&
             data.role in ['admin', 'trainer'] &&
             data.status in ['pending', 'accepted', 'expired'] &&
             data.invitedBy is string &&
             data.invitedByName is string &&
             data.sentAt is string;
    }

    function isValidInventoryItem(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.category in ['equipment', 'retail-equipment', 'retail-food-drink', 'retail-apparel', 'staff-apparel'] &&
             data.location in ['Dorset Street', 'Shelburne Road', 'West Palm Beach'] &&
             data.quantity is number &&
             (data.price == null || data.price is number) &&
             data.updatedAt is string &&
             (data.productLink == null || data.productLink is string);
    }

    function isValidInventoryReport(data) {
      return data.location in ['Dorset Street', 'Shelburne Road', 'West Palm Beach'] &&
             data.reportedBy is string &&
             data.reportedByName is string &&
             data.reportedAt is string &&
             data.items is list;
    }

    function isValidMail(data) {
      return (data.to is string || data.to is list) &&
             data.message is map &&
             data.message.subject is string &&
             (data.message.html is string || data.message.text is string);
    }

    function isValidResource(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.url is string && data.url.size() > 0 &&
             data.createdAt is string &&
             data.createdBy is string &&
             (data.category == null || data.category is string);
    }

    // ===============================================================
    // Routes
    // ===============================================================

    // Users collection
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) && isValidUser(request.resource.data)) || isAdmin();
      allow delete: if isAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.assignedTo || request.auth.uid == resource.data.createdBy);
      allow create: if isAdmin() && isValidTask(request.resource.data) && request.auth.uid == request.resource.data.createdBy;
      allow update: if (isAdmin() || (isAuthenticated() && (request.auth.uid == resource.data.assignedTo || request.auth.uid == resource.data.createdBy))) && isValidTask(request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }

    // Invites collection
    match /invites/{email} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email.lower() == email.lower());
      allow write: if isAdmin() && isValidInvite(request.resource.data);
      allow delete: if isAdmin();
    }

    // Alerts collection
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Staff collection (Managed entities)
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Vacations collection
    match /vacations/{vacationId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Inventory collection
    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isStaff() && isValidInventoryItem(request.resource.data);
      allow update: if isStaff() && isValidInventoryItem(request.resource.data);
      allow delete: if isAdmin();
    }
    
    // Inventory Reports collection
    match /inventoryReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidInventoryReport(request.resource.data);
      allow delete: if isAdmin();
    }
    
    // Mail collection (Trigger Email extension)
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isValidMail(request.resource.data);
    }

    // Resources collection
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidResource(request.resource.data);
      allow delete: if isAdmin();
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
